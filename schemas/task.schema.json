{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"GPTAuto Task Contract v0.2",
  "type":"object",
  "required":["task_id","goal","repository","definition_of_done","state","plan"],
  "properties":{
    "task_id":{"type":"string","minLength":1},
    "goal":{"type":"string","minLength":1},
    "repository":{"type":"string","pattern":"^[^/]+/[^/]+$"},
    "definition_of_done":{"type":"array","minItems":1,"items":{"type":"object","required":["text","status"],"properties":{"text":{"type":"string","minLength":1},"status":{"enum":["pending","passed","failed"]},"evidence":{"type":"string"}}}},
    "state":{"enum":["GOAL","PLAN","EXECUTE","VERIFY","DONE","BLOCKED"]},
    "plan":{"type":"array","minItems":1,"items":{"type":"object","required":["gate","required","status"],"properties":{"gate":{"enum":["INSPECT","IMPLEMENT","COMMIT","PR","PR_CI","MERGE","MAIN_CI","RELEASE","DEPLOY","RUNTIME_VERIFY"]},"required":{"type":"boolean"},"status":{"enum":["pending","waiting","passed","failed","skipped"]},"evidence":{"type":"string"}}}},
    "repair_attempts":{"type":"integer","minimum":0},"max_repair_attempts":{"type":"integer","minimum":1},"metadata":{"type":"object"},"history":{"type":"array"}
  },"additionalProperties":true
}
